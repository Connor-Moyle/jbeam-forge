{
  "name": "jbeam-forge",
  "version": "0.11.0",
  "private": true,
  "description": "Turn a 3D vehicle model into an installable BeamNG.drive mod",
  "author": "Fatkiwi",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test-web.json",
    "lint": "eslint . && node scripts/lint-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "run-desktop": "electron-vite build && node scripts/run-desktop.mjs",
    "study-vehicle": "tsx --tsconfig tsconfig.node.json scripts/study-vehicle.ts",
    "jbeam:corpus": "tsx --tsconfig tsconfig.node.json scripts/jbeam-corpus.ts",
    "extract-reference": "tsx --tsconfig tsconfig.node.json scripts/extract-reference.ts",
    "build-taxonomy": "tsx --tsconfig tsconfig.node.json scripts/build-taxonomy.ts",
    "classify:bench": "tsx --tsconfig tsconfig.node.json scripts/classify-bench.ts",
    "study-structure": "tsx --tsconfig tsconfig.node.json scripts/study-structure.ts",
    "lint-mod": "tsx --tsconfig tsconfig.node.json scripts/lint-mod.ts",
    "proxy-bench": "tsx --tsconfig tsconfig.test-web.json scripts/web/proxy-bench.ts",
    "dump-reference": "tsx --tsconfig tsconfig.node.json scripts/dump-reference-structure.ts",
    "bench:solver": "tsx --tsconfig tsconfig.node.json scripts/bench-solver.ts",
    "make-icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs",
    "study-prices": "tsx --tsconfig tsconfig.node.json scripts/study-prices.ts",
    "project-bench": "tsx --tsconfig tsconfig.node.json scripts/project-bench.ts",
    "build-material-pack": "tsx --tsconfig tsconfig.node.json scripts/build-material-pack.ts",
    "build-object-pack": "tsx --tsconfig tsconfig.node.json scripts/build-object-pack.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "dockview-react": "^8.3.1",
    "electron-log": "^5.4.4",
    "immer": "^11.1.18",
    "lucide-react": "^1.48.0",
    "meshoptimizer": "^1.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "yazl": "^3.3.1"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
